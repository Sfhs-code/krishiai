# Copy to functions/.env and fill in. Never commit the real file.

# Google AI Studio key — https://aistudio.google.com/apikey
# Powers: AI chat, leaf disease vision, counterfeit label reading,
# land diversification planning, scheme translation.
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# OpenWeather key — https://home.openweathermap.org/api_keys
# Powers: current weather, 5-day forecast, smart irrigation alert, reverse geocoding.
OPENWEATHER_API_KEY=

# Optional. data.gov.in key for live Agmarknet mandi prices —
# https://data.gov.in/apis  (without this, curated market data is served)
DATA_GOV_API_KEY=
DATA_GOV_RESOURCE=9ef84268-d588-465a-a308-a864a43d0070
