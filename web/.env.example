# Copy to web/.env.local for local development. All values are optional —
# the Firebase web config below is already baked in as the default.

# Point the frontend at a deployed backend instead of the local emulator.
# Leave unset in production: Firebase Hosting rewrites /api/** to the function.
# VITE_API_BASE=https://us-central1-krishisathi-sfhs.cloudfunctions.net/api

# Origin of the Functions emulator during `npm run dev` (see vite.config.ts).
# VITE_FUNCTIONS_ORIGIN=http://127.0.0.1:5001

# Firebase web config. These are public by design (they identify the project,
# they do not grant access — Firestore rules do that). Override only if you
# fork the project onto your own Firebase instance.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
