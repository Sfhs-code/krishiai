rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A farmer's profile and diary are private to that farmer. Nothing in this
    // app is shared between accounts, so there is no public read anywhere.
    match /farmers/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /diary/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /scans/{scanId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Counterfeit reports are write-only from the client: a farmer can file a
    // report but cannot read anyone else's. Review happens server-side.
    match /counterfeit_reports/{reportId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'barcode', 'brand', 'note', 'createdAt']);
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
